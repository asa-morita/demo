{
  "name": "demo",
  "compatibility_date": "2026-10-09",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TOURNAMENT_STORE",
        "class_name": "TournamentStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "admin-store-v1",
      "new_sqlite_classes": [
        "TournamentStore"
      ]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "TOURNAMENT_STORE",
          "class_name": "TournamentStore"
        }
      ]
    }
  }
}
